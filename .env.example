# Copy to .env.local for local overrides. Nothing here is secret – never put secrets in VITE_* variables,
# they are compiled into the public JavaScript bundle.

# Base path the site is served from. GitHub Pages project site: /juhlahumut-demo/ – custom domain root: /
VITE_BASE_PATH=/juhlahumut-demo/

# Absolute origin + base of the deployed site (no trailing slash). Used for Open Graph image URLs and,
# when indexing is allowed, for canonical URLs and the sitemap. Leave empty locally.
SITE_URL=

# Keep "false" for the demo. Only set to "true" on the company's own production domain, with authorisation.
ALLOW_INDEXING=false

# Quote form transport: "mock" (demo – nothing is sent) or "apps-script" (future, see docs/BACKEND_INTEGRATION.md)
VITE_QUOTE_TRANSPORT=mock

# Future integration (public values only – the reCAPTCHA SECRET key lives in Apps Script, never here)
# VITE_QUOTE_ENDPOINT=https://script.google.com/macros/s/XXXX/exec
# VITE_RECAPTCHA_SITE_KEY=

# Force the neutral wordmark instead of the authentic logo artwork
# VITE_BRAND_LOGO=wordmark
